rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Single-user app: everything is locked to one hardcoded Firebase Auth UID.
    // Replace the placeholder with your UID (Firebase console → Authentication → Users → User UID),
    // then deploy with: firebase deploy --only firestore:rules
    match /{document=**} {
      allow read, write: if request.auth != null
                          && request.auth.uid == "REPLACE_WITH_YOUR_FIREBASE_UID";
    }
  }
}
